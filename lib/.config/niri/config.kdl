// niri 配置文件
// 格式说明: https://kdl.dev
// 完整文档: https://yalter.github.io/niri/Configuration:-Introduction

// ----------------------------------------------------------
// 输入设备
// ----------------------------------------------------------

input {
    focus-follows-mouse                  // 鼠标悬停时自动聚焦窗口

    keyboard {
        xkb {
            // rules/model/layout/variant/options 均可在此设置
            // 参考: xkeyboard-config(7)
            // 留空时从 org.freedesktop.locale1 读取（可用 localectl 管理）
        }

        numlock                          // 启动时默认开启 NumLock
    }

    touchpad {
        tap                              // 单指点击 = 左键
        // dwt                           // 打字时禁用触摸板（disable-while-typing）
        // natural-scroll               // 自然滚动：内容跟手指方向一致（反向为传统滚动）
        // accel-speed 0.2              // 指针加速度，范围 -1.0（最慢）~ 1.0（最快），0 为默认
        // accel-profile "flat"         // 加速曲线: flat = 线性无加速，adaptive = 系统自适应（默认）
        // disabled-on-external-mouse   // 接外接鼠标时禁用触摸板
    }

    mouse {
        // natural-scroll               // 自然滚动
        // accel-speed 0.2              // 指针加速度，范围 -1.0 ~ 1.0
        // accel-profile "flat"         // 加速曲线: flat = 线性，adaptive = 自适应（默认）
    }

    trackpoint {
        // natural-scroll               // 自然滚动
        // accel-speed 0.2              // 指针加速度
        // middle-emulation             // 左右键同时按模拟中键
    }

    // warp-mouse-to-focus             // 切换焦点时鼠标跳到目标窗口中心
    // focus-follows-mouse max-scroll-amount="0%"  // 限制跟焦引发的视图滚动量（0% = 不滚动）
}

// ----------------------------------------------------------
// 显示器输出
// 运行 `niri msg outputs` 查看当前连接的显示器及可用模式
// ----------------------------------------------------------

output "eDP-1" {                        // 笔记本内屏（名称通过 niri msg outputs 确认）
    mode "1920x1080@120.030"            // 分辨率@刷新率，留空则使用显示器首选模式
    scale 1                             // 缩放比例: 1 = 100%，1.5 = 150%，2 = 200%（HiDPI 用）
    transform "normal"                  // 旋转方向: normal / 90 / 180 / 270 / flipped / flipped-90 / flipped-180 / flipped-270
    position x=1280 y=0                 // 在多显示器布局中的像素坐标（原点为左上角）
}

// output "HDMI-A-1" {                 // 外接显示器（按需取消注释）
//     mode "2560x1440@144"
//     scale 1.5
//     position x=0 y=0               // 放在内屏左侧
// }

// ----------------------------------------------------------
// 布局与视觉效果
// ----------------------------------------------------------

layout {
    gaps 8                             // 窗口间距（像素），同时作用于窗口与屏幕边缘
    // center-focused-column 可选值:
    //   "always"      — 始终将当前列居中（即使列很少也会滚动）
    //   "on-overflow"  — 仅当列超出屏幕宽度时才居中
    //   "never"       — 不自动居中
    center-focused-column "always"

    preset-column-widths {             // Mod+R 循环切换的预设宽度
        proportion 0.33333             // 三分之一屏
        proportion 0.5                 // 二分之一屏
        proportion 0.66667             // 三分之二屏
    }

    // 新窗口默认宽度，window-rules 中无匹配时生效
    // 可选: proportion 0.0~1.0（屏幕比例）或 fixed 800（固定像素）或 {} 跟随窗口自报宽度
    default-column-width { proportion 0.8; }

    focus-ring {                       // 焦点环：显示在当前窗口边缘的高亮描边
        off                            // off = 关闭，on = 开启
        width 2                        // 描边宽度（像素）
        active-color "#7fc8ff66"       // 获得焦点时的颜色（支持 #RRGGBB 或 #RRGGBBAA）
        inactive-color "#505050"       // 失去焦点时的颜色
    }

    border {                           // 窗口边框（可与焦点环同时开，也可二选一）
        off                            // off = 关闭，on = 开启
        width 0                        // 边框宽度（像素）
        inactive-color "#00000000"     // 非激活边框色（完全透明）
        urgent-color "#9b0000"         // 窗口发出紧急信号时的边框色
        // active-gradient 语法: from="起始色" to="结束色" angle=角度 relative-to="..." in="色彩空间"
        // relative-to 可选: "window"（相对窗口）/ "workspace-view"（相对整个工作区视图，多窗口颜色连续）
        // in 可选: "srgb" / "oklch shorter hue" / "oklch longer hue" 等色彩插值空间
        active-gradient from="#e5989b" to="#ffb4a2" angle=45 relative-to="workspace-view" in="oklch longer hue"
    }

    shadow {                           // 窗口阴影
        on                             // off = 关闭，on = 开启
        softness 30                    // 模糊半径，越大越柔和
        spread 5                       // 阴影扩散大小，正值向外扩，负值向内缩
        offset x=0 y=5                 // 阴影偏移：x 正值向右，y 正值向下
        color "#0007"                  // 阴影颜色，#RRGGBBAA，最后两位控制透明度
    }

    struts {                           // 边缘保留区域（窗口不会铺到此区域，用于给 waybar 等留空间）
        // left 64                     // 左侧保留像素
        // right 64                    // 右侧保留像素
        // top 64                      // 顶部保留像素（waybar 在顶部时设为 bar 高度）
        // bottom 64                   // 底部保留像素
    }
}

// ----------------------------------------------------------
// 工作区
// ----------------------------------------------------------

workspace "terminal"                   // 工作区 1：终端
workspace "repository"                 // 工作区 2：代码仓库
workspace "browser"                    // 工作区 3：浏览器
// workspace "social"                  // 工作区 4：社交（备用）
// workspace "service"                 // 工作区 5：服务（备用）

// ----------------------------------------------------------
// 自启动程序
// ----------------------------------------------------------

spawn-at-startup "fcitx5"                                         // 输入法框架
spawn-at-startup "hyprpaper"                                      // 壁纸程序
spawn-sh-at-startup "bash ~/.config/niri/scripts/bg_swaybg.sh"   // 备用壁纸脚本（swaybg）
// spawn-at-startup "waybar"                                      // 状态栏（手动控制时注释掉）

// ----------------------------------------------------------
// 外观与行为
// ----------------------------------------------------------

hotkey-overlay {
    skip-at-startup                    // 启动时不显示快捷键提示层（首次启动后建议开启）
}

prefer-no-csd                          // 优先使用服务端装饰（SSD）而非客户端装饰（CSD）；部分应用可能无视此项

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"  // 截图保存路径，支持 strftime 时间格式

animations {
    // off                             // 关闭所有动画
    // slowdown 3.0                    // 动画速度倍率：>1 变慢（调试用），<1 变快，默认 1.0
}

overview {
    backdrop-color "#9999ff"           // 概览模式背景色（支持 #RRGGBB 或 #RRGGBBAA）
    zoom 0.5                           // 概览缩放比例：0.5 = 缩小到一半，范围 0.0 ~ 1.0
}

layer-rule {
    match namespace="^wallpaper$"      // 匹配 layer-shell 命名空间为 wallpaper 的层（hyprpaper/swaybg 等）
    place-within-backdrop true         // 将该层置于概览背景色之内（使概览遮住壁纸）
}

// ----------------------------------------------------------
// Noctalia 模糊（niri 26.04+，Noctalia 通过 ext-background-effects 自动发布模糊区域）
// ----------------------------------------------------------
layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false                     // 关闭 xray，避免圆角边缘透出壁纸色
        // blur false                  // 若不想要模糊，取消注释此行
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"   // 窗口切换器单独开模糊
    background-effect {
        blur true
        xray false
    }
}

// 全局模糊参数微调
blur {
    passes 2                           // 模糊次数，越多越强（默认 3）
    offset 3.0                         // 每次取样距离（默认 3.0）
    noise 0.03                         // 噪点纹理（默认 0.02）
    saturation 1.1                     // 颜色饱和度提升（默认 1.5）
}

// ----------------------------------------------------------
// 窗口规则与按键绑定
// ----------------------------------------------------------

include "window-rules.kdl"            // 窗口规则（浮动、圆角、隐私屏蔽等）
include "binds.kdl"                   // 快捷键绑定


include "noctalia.kdl"
