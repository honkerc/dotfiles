// ============================================================
// 按键绑定
// 文档: https://yalter.github.io/niri/Configuration:-Key-Bindings
// 修饰键: Mod = TTY 下为 Super，winit 窗口中为 Alt
// 查找键名: 使用 wev 工具
// ============================================================

binds {

    // ===== 系统 =====
    Mod+Shift+Slash                          hotkey-overlay-title="显示快捷键列表"        { show-hotkey-overlay; }
    Mod+Escape allow-inhibiting=false        hotkey-overlay-title="切换快捷键抑制"        { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+Q                              hotkey-overlay-title="退出 niri"              { quit; }
    Ctrl+Alt+Delete                          hotkey-overlay-title="退出 niri"              { quit; }
    Mod+Shift+P                              hotkey-overlay-title="关闭显示器"             { power-off-monitors; }

    // ===== 启动应用 =====
    Mod+Return                               hotkey-overlay-title="终端"                   { spawn "alacritty"; }
    Mod+D                                    hotkey-overlay-title="启动器"                 { spawn "~/.config/rofi/launchers/misc/launcher.sh"; }
    Mod+C                                    hotkey-overlay-title="浏览器"                 { spawn-sh "zen-browser"; }
    Mod+E                                    hotkey-overlay-title="编辑器"                 { spawn-sh "obsidian"; }
    Mod+Shift+D                              hotkey-overlay-title="锁屏"                   { spawn "swaylock"; }
    Mod+Shift+B                              hotkey-overlay-title="切换 waybar"            { spawn "~/.config/niri/scripts/toggle-waybar.sh"; }
    Mod+Shift+U                              hotkey-overlay-title="备份 config"            { spawn "~/.config/niri/scripts/bakup.sh"; }
    Mod+B                                    hotkey-overlay-title="切换壁纸"               { spawn "~/.config/niri/scripts/set-wallpaper.sh"; }
    Mod+A                                    hotkey-overlay-title="fzf 菜单"               { spawn-sh "alacritty -e ~/.config/niri/scripts/fzfmenu.sh"; }
    Ctrl+Alt+A                               hotkey-overlay-title="自定义截图"             { spawn-sh "~/.config/niri/scripts/screenshot.sh"; }

    // ===== 无障碍 =====
    Mod+Alt+S allow-when-locked=true         hotkey-overlay-title="切换屏幕阅读器"         { spawn-sh "pkill orca || exec orca"; }

    // ===== 媒体与系统键（锁屏时可用）=====
    XF86AudioRaiseVolume allow-when-locked=true   hotkey-overlay-title="音量+"             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+"; }
    XF86AudioLowerVolume allow-when-locked=true   hotkey-overlay-title="音量-"             { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    XF86AudioMute allow-when-locked=true          hotkey-overlay-title="静音"              { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute allow-when-locked=true       hotkey-overlay-title="麦克风静音"        { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp allow-when-locked=true    hotkey-overlay-title="亮度+"             { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown allow-when-locked=true  hotkey-overlay-title="亮度-"             { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // ===== 概览 =====
    Mod+Space repeat=false                   hotkey-overlay-title="切换概览"               { toggle-overview; }

    // ===== 窗口管理 =====
    Mod+Q repeat=false                       hotkey-overlay-title="关闭窗口"               { close-window; }
    Mod+V                                    hotkey-overlay-title="切换浮动/平铺"          { toggle-window-floating; }
    Mod+Shift+V                              hotkey-overlay-title="浮动与平铺间切焦"       { switch-focus-between-floating-and-tiling; }
    Mod+W                                    hotkey-overlay-title="切换列标签模式"         { toggle-column-tabbed-display; }
    Mod+F                                    hotkey-overlay-title="最大化列"               { maximize-column; }
    Mod+Shift+F                              hotkey-overlay-title="全屏窗口"               { fullscreen-window; }
    Mod+Ctrl+F                               hotkey-overlay-title="填充剩余宽度"           { expand-column-to-available-width; }

    // ===== 焦点移动 =====
    Mod+H                                    hotkey-overlay-title="焦点左"                 { focus-column-left; }
    Mod+J                                    hotkey-overlay-title="焦点下"                 { focus-window-down; }
    Mod+K                                    hotkey-overlay-title="焦点上"                 { focus-window-up; }
    Mod+L                                    hotkey-overlay-title="焦点右"                 { focus-column-right; }
    Mod+Tab                                  hotkey-overlay-title="下一列"                 { focus-column-right; }
    Mod+Shift+Tab                            hotkey-overlay-title="上一列"                 { focus-column-left; }
    Mod+Home                                 hotkey-overlay-title="首列"                   { focus-column-first; }
    Mod+End                                  hotkey-overlay-title="末列"                   { focus-column-last; }

    // ===== 窗口/列移动 =====
    Mod+Ctrl+H                               hotkey-overlay-title="列左移"                 { move-column-left; }
    Mod+Ctrl+J                               hotkey-overlay-title="窗口下移"               { move-window-down; }
    Mod+Ctrl+K                               hotkey-overlay-title="窗口上移"               { move-window-up; }
    Mod+Ctrl+L                               hotkey-overlay-title="列右移"                 { move-column-right; }
    Mod+Ctrl+Home                            hotkey-overlay-title="列移到首位"             { move-column-to-first; }
    Mod+Ctrl+End                             hotkey-overlay-title="列移到末位"             { move-column-to-last; }

    // ===== 显示器焦点 =====
    Mod+Shift+H                              hotkey-overlay-title="左显示器"               { focus-monitor-left; }
    Mod+Shift+J                              hotkey-overlay-title="下显示器"               { focus-monitor-down; }
    Mod+Shift+K                              hotkey-overlay-title="上显示器"               { focus-monitor-up; }
    Mod+Shift+L                              hotkey-overlay-title="右显示器"               { focus-monitor-right; }

    // ===== 列移动到显示器 =====
    Mod+Shift+Ctrl+H                         hotkey-overlay-title="移到左显示器"           { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+J                         hotkey-overlay-title="移到下显示器"           { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+K                         hotkey-overlay-title="移到上显示器"           { move-column-to-monitor-up; }
    Mod+Shift+Ctrl+L                         hotkey-overlay-title="移到右显示器"           { move-column-to-monitor-right; }

    // ===== 工作区导航 =====
    Mod+U                                    hotkey-overlay-title="下一工作区"             { focus-workspace-down; }
    Mod+I                                    hotkey-overlay-title="上一工作区"             { focus-workspace-up; }
    Mod+Ctrl+U                               hotkey-overlay-title="列移到下工作区"         { move-column-to-workspace-down; }
    Mod+Ctrl+I                               hotkey-overlay-title="列移到上工作区"         { move-column-to-workspace-up; }
    // Mod+Shift+U                              hotkey-overlay-title="工作区下移"             { move-workspace-down; }
    Mod+Shift+I                              hotkey-overlay-title="工作区上移"             { move-workspace-up; }

    // ===== 工作区直跳（1-5）=====
    Mod+1                                    hotkey-overlay-title="工作区 1"               { focus-workspace 1; }
    Mod+2                                    hotkey-overlay-title="工作区 2"               { focus-workspace 2; }
    Mod+3                                    hotkey-overlay-title="工作区 3"               { focus-workspace 3; }
    Mod+4                                    hotkey-overlay-title="工作区 4"               { focus-workspace 4; }
    Mod+5                                    hotkey-overlay-title="工作区 5"               { focus-workspace 5; }

    // ===== 列移到工作区（1-5）=====
    Mod+Shift+1                              hotkey-overlay-title="列移到 1"               { move-column-to-workspace 1; }
    Mod+Shift+2                              hotkey-overlay-title="列移到 2"               { move-column-to-workspace 2; }
    Mod+Shift+3                              hotkey-overlay-title="列移到 3"               { move-column-to-workspace 3; }
    Mod+Shift+4                              hotkey-overlay-title="列移到 4"               { move-column-to-workspace 4; }
    Mod+Shift+5                              hotkey-overlay-title="列移到 5"               { move-column-to-workspace 5; }

    // ===== 鼠标滚轮 =====
    Mod+WheelScrollDown cooldown-ms=150      hotkey-overlay-title="下一工作区"             { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150        hotkey-overlay-title="上一工作区"             { focus-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 hotkey-overlay-title="列移到下工作区"         { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp cooldown-ms=150   hotkey-overlay-title="列移到上工作区"         { move-column-to-workspace-up; }

    Mod+WheelScrollRight                     hotkey-overlay-title="右列"                   { focus-column-right; }
    Mod+WheelScrollLeft                      hotkey-overlay-title="左列"                   { focus-column-left; }
    Mod+Ctrl+WheelScrollRight                hotkey-overlay-title="列右移"                 { move-column-right; }
    Mod+Ctrl+WheelScrollLeft                 hotkey-overlay-title="列左移"                 { move-column-left; }

    Mod+Shift+WheelScrollDown                hotkey-overlay-title="右列"                   { focus-column-right; }
    Mod+Shift+WheelScrollUp                  hotkey-overlay-title="左列"                   { focus-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown           hotkey-overlay-title="列右移"                 { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp             hotkey-overlay-title="列左移"                 { move-column-left; }

    // ===== 列操作 =====
    Mod+BracketLeft                          hotkey-overlay-title="吸入/排出左列"          { consume-or-expel-window-left; }
    Mod+BracketRight                         hotkey-overlay-title="吸入/排出右列"          { consume-or-expel-window-right; }
    Mod+Comma                                hotkey-overlay-title="吸入窗口到当前列"       { consume-window-into-column; }
    Mod+Period                               hotkey-overlay-title="排出窗口到右侧"         { expel-window-from-column; }
    Mod+Ctrl+C                               hotkey-overlay-title="居中可见列"             { center-visible-columns; }

    // ===== 尺寸调整 =====
    Mod+R                                    hotkey-overlay-title="循环列宽预设"           { switch-preset-column-width; }
    Mod+Shift+R                              hotkey-overlay-title="循环窗口高度预设"       { switch-preset-window-height; }
    Mod+Ctrl+R                               hotkey-overlay-title="重置窗口高度"           { reset-window-height; }
    Mod+Minus                                hotkey-overlay-title="列宽 -10%"              { set-column-width "-10%"; }
    Mod+Equal                                hotkey-overlay-title="列宽 +10%"              { set-column-width "+10%"; }
    Mod+Shift+Minus                          hotkey-overlay-title="窗口高度 -10%"          { set-window-height "-10%"; }
    Mod+Shift+Equal                          hotkey-overlay-title="窗口高度 +10%"          { set-window-height "+10%"; }

    // ===== 截图 =====
    Print                                    hotkey-overlay-title="区域截图"               { screenshot; }
    Ctrl+Print                               hotkey-overlay-title="整屏截图"               { screenshot-screen; }
    Alt+Print                                hotkey-overlay-title="窗口截图"               { screenshot-window; }
}
