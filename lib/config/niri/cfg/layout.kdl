// ============================================================
//  布局 + 外观
//  窗口怎么排、怎么模糊、描边什么样，都在这
//  改完执行: niri msg action reload-config
// ============================================================


layout {

    // ── 间距 ──
    gaps 8

    // ── 当前窗口是否自动居中 ──
    // "always"      永远居中
    // "on-overflow" 挤满了才居中
    // "never"       永远不居中
    center-focused-column "always"


    // ★★★ 关键：让 niri 根背景透明，Noctalia 壁纸才能透出来 ★★★
    background-color "transparent"


    // ── Mod+R 循环切换的窗口宽度 ──
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    // ── 新窗口默认宽度 ──
    default-column-width { proportion 0.8; }

    // ── 屏幕边缘留白（给 Noctalia bar 用）──
    struts {
        // left 64
        // right 64
        // top 48
        // bottom 48
    }


    // ── 焦点环 ──
    focus-ring {
        off
        width 2
        active-color "#7fc8ff66"
        inactive-color "#505050"
    }


    // ── 边框 ──
    border {
        off
        width 0
        inactive-color "#00000000"
        urgent-color "#9b0000"
    }


    // ── 阴影 ──
    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}


// ──────────────────────────────────────────────────────────
//  概览（Mod+Space 打开的那个视图）
//  桌面是 Noctalia 壁纸，但概览缩小时用这里的背景色
// ──────────────────────────────────────────────────────────
overview {
    backdrop-color "#00000000"   // 概览背景色，保留你原来的
    zoom 0.5
}


// ──────────────────────────────────────────────────────────
//  全局模糊
// ──────────────────────────────────────────────────────────
blur {
    passes 2
    offset 3.0
    noise 0.03
    saturation 1.1
}

// 5 个持久化命名工作区
workspace "1"
workspace "2"
workspace "3"
workspace "4"
// workspace "5"
